# ==============================================================================
# BookHaven — Environment Configuration Template
# ==============================================================================
# Copy this file to .env inside backend/ for local development:
#   cp .env.example .env
# Never commit real secrets to source control!
# ==============================================================================

# ─── Django Core Settings ────────────────────────────────────────────────────
# In production, DEBUG MUST be False.
DEBUG=False

# Generate a strong 50+ character random string for production.
SECRET_KEY=django-insecure-bookhaven-dev-secret-key-change-in-production-xyz123

# Comma-separated list of hostnames/domains.
# In Render production, add: .onrender.com,your-custom-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# ─── Database Configuration ──────────────────────────────────────────────────
# Production (Render PostgreSQL):
# Provided automatically by Render as an environment variable when linked to Render Postgres:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
#
# Local Development (SQLite fallback):
# Leave DATABASE_URL commented out to automatically use SQLite (db.sqlite3).
#
# Local Development (Optional MySQL):
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=bookhaven_db
# DB_USER=bookhaven_user
# DB_PASSWORD=BookHaven@2026
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ─── CORS & CSRF Configuration ───────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# NEVER use wildcard * in production!
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Trusted origins for CSRF protection (must include protocol)
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://your-frontend.vercel.app

# ─── Clerk Authentication (https://clerk.com) ────────────────────────────────
# Found on the Clerk Dashboard API Keys page:
CLERK_FRONTEND_API_URL=https://ready-stag-1023.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Optional Production Overrides ───────────────────────────────────────────
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=2
# DJANGO_LOG_LEVEL=INFO
# SECURE_SSL_REDIRECT=False
RAZORPAY_KEY_ID=rzp_test_TaeA7VnqRyVNqD
RAZORPAY_KEY_SECRET=uU9dQdfPwzPNavLPYb70fQ4M